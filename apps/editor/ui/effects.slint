// The «Эффекты» tab (effects spec §6.1): search, filter chips, a grid of
// cards, a hint line. Rust builds the rows (stable models, keyed by recipe
// id) and does hover delays, click and drag; Slint only draws and reports
// the pointer. Also the inspector's effect blocks (§6.2, `FxBlock`).

import { Theme, Icons } from "theme.slint";
import { Tr } from "i18n.slint";
import { Icon, IconButton, PanelTabs, EmptyState, Tooltip, AnimRow, KeyState, BoundSwitch } from "widgets.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export struct FxCategoryView {
    key: string,
    label: string,
}

export struct FxCardView {
    id: string,
    name: string,
    category: string,
    thumb: image,
    has-thumb: bool,
    enabled: bool,
    // Why the card is inactive ("" when it is not): shown on hover.
    hint: string,
}

component FxCard inherits Rectangle {
    in property <FxCardView> c;
    // A drag from this card is over a target that refuses it.
    in property <bool> refused;
    callback hover(bool);
    // Window coordinates.
    callback pressed(length, length);
    callback moved(length, length);
    callback released(length, length);
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.bg4 : ta.has-hover && root.c.enabled ? Theme.bg3 : Theme.bg2;
    border-width: 1px;
    border-color: ta.has-hover && root.c.enabled ? Theme.accent : Theme.border;
    opacity: root.c.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.c.name;
    animate background, border-color { duration: 90ms; }
    VerticalLayout {
        padding: 4px;
        spacing: 4px;
        // 16:9, as the thumbnails (rendered at 160 × 90).
        Rectangle {
            height: (root.width - 8px) * 9 / 16;
            border-radius: 4px;
            background: #000000;
            clip: true;
            if root.c.has-thumb: Image { width: parent.width; height: parent.height; source: root.c.thumb; image-fit: cover; }
            if !root.c.has-thumb: Icon { icon: root.c.category == "motion" ? Icons.motion : Icons.sparkle; width: 22px; height: 22px; color: Theme.text-faint; }
        }
        // Two lines: a long name wraps in a narrow panel instead of eliding.
        Text {
            text: root.c.name;
            font-size: Theme.font-sm;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
    }
    ta := TouchArea {
        // A dimmed card still drags onto a clip it fits: a pointer, not "not
        // allowed" (its tooltip says why a click does nothing).
        mouse-cursor: self.pressed ? (root.refused ? no-drop : grabbing) : pointer;
        changed has-hover => { root.hover(self.has-hover); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.pressed(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.released(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); }
        }
        moved => {
            if (self.pressed) { root.moved(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); }
        }
    }
}

export component EffectsPanel inherits Rectangle {
    in property <[FxCategoryView]> categories;
    in property <string> category;
    in property <[FxCardView]> cards;
    // How to use the cards, or "Select a clip to try effects on it".
    in property <string> hint;
    // A card drag is over a target that refuses it.
    in property <bool> drag-refused;
    in-out property <string> search;
    callback tab-selected(int);
    callback category-selected(string);
    callback search-changed(string);
    callback card-hover(string, bool);
    callback card-pressed(string, length, length);
    callback card-moved(string, length, length);
    callback card-released(string, length, length);
    // The card under the pointer (its hint shows when it is inactive) and
    // its box in panel coordinates. Drawn by the panel, not the card: the
    // scroll area would clip a card's own tooltip at its edges. A card
    // filtered out is destroyed without a pointer leave: the id check (and
    // the resets on search / chip / hiding) keep its hint from staying.
    property <int> tip-index: -1;
    property <string> tip-id;
    property <length> tip-x;
    property <length> tip-top;
    property <length> tip-bottom;
    background: Theme.bg1;
    changed visible => { root.tip-index = -1; }

    VerticalLayout {
        PanelTabs {
            tabs: [Tr.t("media.title"), Tr.t("fx.title")];
            current: 1;
            selected(i) => { root.tab-selected(i); }
        }
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 4px;
            spacing: 8px;
            LineEdit {
                placeholder-text: Tr.t("fx.search");
                text <=> root.search;
                edited(t) => {
                    root.tip-index = -1;
                    root.search-changed(t);
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for cat in root.categories: Rectangle {
                    width: ct.preferred-width + 20px;
                    height: 24px;
                    border-radius: 12px;
                    background: root.category == cat.key ? Theme.bg4 : cta.has-hover ? Theme.bg3 : Theme.bg2;
                    border-width: 1px;
                    border-color: root.category == cat.key ? Theme.border-strong : Theme.border;
                    accessible-role: button;
                    accessible-label: cat.label;
                    ct := Text { text: cat.label; font-size: Theme.font-sm; color: root.category == cat.key ? Theme.text : Theme.text-dim; }
                    cta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.tip-index = -1;
                            root.category-selected(cat.key);
                        }
                    }
                }
            }
        }
        if root.cards.length == 0: EmptyState {
            icon: Icons.sparkle;
            title: Tr.t("fx.no_match");
            subtitle: "";
        }
        if root.cards.length > 0: sv := ScrollView {
            vertical-stretch: 1;
            property <length> gap: 8px;
            // At least two columns, cards near the thumbnails' 160 px.
            property <int> cols: max(2, floor((self.visible-width - 8px) / 168px));
            property <length> card-w: (self.visible-width - 16px - (self.cols - 1) * self.gap) / self.cols;
            // The 16:9 picture, paddings and two lines of name.
            property <length> card-h: (self.card-w - 8px) * 9 / 16 + 42px;
            content-width: self.visible-width;
            content-height: ceil(root.cards.length * 1.0 / self.cols) * (self.card-h + self.gap) + 4px;
            for card[i] in root.cards: FxCard {
                x: 8px + mod(i, sv.cols) * (sv.card-w + sv.gap);
                y: 4px + floor(i / sv.cols) * (sv.card-h + sv.gap);
                width: sv.card-w;
                height: sv.card-h;
                c: card;
                refused: root.drag-refused;
                hover(on) => {
                    if (on) {
                        root.tip-index = i;
                        root.tip-id = card.id;
                        root.tip-x = self.absolute-position.x - root.absolute-position.x + self.width / 2;
                        root.tip-top = self.absolute-position.y - root.absolute-position.y;
                        root.tip-bottom = root.tip-top + self.height;
                    } else if (root.tip-index == i) {
                        root.tip-index = -1;
                    }
                    root.card-hover(card.id, on);
                }
                pressed(x, y) => { root.card-pressed(card.id, x, y); }
                moved(x, y) => { root.card-moved(card.id, x, y); }
                released(x, y) => { root.card-released(card.id, x, y); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 7px;
            Text { text: root.hint; font-size: Theme.font-xs; color: Theme.text-dim; wrap: word-wrap; }
        }
    }

    // The inactive card's hint: below it, or above when that leaves the panel.
    if root.tip-index >= 0 && root.cards[root.tip-index].id == root.tip-id && root.cards[root.tip-index].hint != "": Tooltip {
        text: root.cards[root.tip-index].hint;
        x: max(4px, min(root.width - self.width - 4px, root.tip-x - self.width / 2));
        y: root.tip-bottom + 4px + self.height <= root.height - 4px ? root.tip-bottom + 4px : root.tip-top - self.height - 4px;
    }
}

// ------------------------------------------------------------ inspector

export struct FxParamRow {
    key: string,
    // "fx:<effect-id>:<key>": a number row's live / commit / key actions.
    prop: string,
    kind: int, // 0 number, 1 choice, 2 point, 3 moment
    label: string,
    value: float,
    minimum: float,
    maximum: float,
    default-value: float,
    k: KeyState,
    // Strength: 0–100 % with marks at 30 / 60 / 90 % and snapping.
    strength: bool,
    // A choice's option keys (the icons follow from them) and their names.
    options: [string],
    tips: [string],
    current: int,
    // Point: "50%, 50%"; Moment: the timecode of its frame.
    text: string,
    hint: string,
    // Point: picking possible; Moment: "to the playhead" possible.
    can-act: bool,
    // Point: being picked on the preview now.
    active: bool,
}

export struct FxRow {
    id: string,
    name: string,
    enabled: bool,
    // false: a recipe or version from a newer Kadr (kept, never run).
    known: bool,
    // «Сбросить» would change something (greyed out otherwise).
    resettable: bool,
    first: bool,
    last: bool,
    params: [FxParamRow],
}

// A choice drawn with icons (zoom in / out, pan arrows) and a tooltip naming
// each option. Paths, not arrow glyphs (Windows may draw those as emoji).
component ChoiceSegments inherits Rectangle {
    in property <[string]> options;
    in property <[string]> tips;
    in property <int> current;
    callback selected(int);
    pure function icon-of(key: string) -> string {
        return key == "in" ? Icons.zoom-in : key == "out" ? Icons.zoom-out : key == "left" ? Icons.arrow-left : key == "right" ? Icons.arrow-right : key == "up" ? Icons.arrow-up : key == "down" ? Icons.arrow-down : Icons.sparkle;
    }
    height: 26px;
    width: root.options.length * 30px + 4px;
    border-radius: 5px;
    background: Theme.bg2;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        for o[i] in root.options: Rectangle {
            width: 30px;
            border-radius: 4px;
            background: root.current == i ? Theme.bg4 : sa.has-hover ? Theme.bg3 : transparent;
            accessible-role: button;
            accessible-label: i < root.tips.length ? root.tips[i] : o;
            Icon { icon: root.icon-of(o); width: 14px; height: 14px; color: root.current == i ? Theme.accent : sa.has-hover ? Theme.text : Theme.text-dim; }
            sa := TouchArea {
                mouse-cursor: root.current == i ? default : pointer;
                clicked => {
                    if (i != root.current) { root.selected(i); }
                }
            }
            if sa.has-hover && i < root.tips.length: Tooltip { text: root.tips[i]; x: (parent.width - self.width) / 2; y: -self.height - 4px; }
        }
    }
}

// «Мягко / Обычно / Сильно» under the Strength track's three marks (0..1):
// the label column (84 + 8 px) on the left; the value (62 + 8 px) and
// ◀ ◆ ▶ on the right — PropSlider's geometry. Each caption is centred on
// its mark; the outer two move outwards as far as they must to keep 4 px
// from the middle one — into the label and value columns, empty under the
// slider — so all three show at any inspector width in RU and EN. Should
// even the row not hold them, one caption shows, at its mark: that of the
// band the value is in (< 0.45 «Мягко», < 0.75 «Обычно», else «Сильно»).
component MarkCaptions inherits Rectangle {
    in property <[float]> marks;
    in property <[string]> labels;
    // The strength (0..1): picks the caption shown alone.
    in property <float> value;
    property <length> left: 92px;
    property <length> track: max(0px, root.width - root.left - 70px - Theme.key-nav);
    property <length> ax0: root.left + root.track * root.marks[0] - a.width / 2;
    property <length> bx0: root.left + root.track * root.marks[1] - b.width / 2;
    property <length> cx0: root.left + root.track * root.marks[2] - c.width / 2;
    property <length> ax: min(root.ax0, root.bx0 - 4px - a.width);
    property <length> cx: max(root.cx0, root.bx0 + b.width + 4px);
    property <bool> all: root.ax >= 0 && root.cx + c.width <= root.width;
    property <int> band: root.value < 0.45 ? 0 : root.value < 0.75 ? 1 : 2;
    // Drawn 3 px up, close under the marks (they reach 5 px below the track).
    height: 10px;
    a := Text { x: root.all ? root.ax : max(0px, min(root.width - self.width, root.ax0)); y: -3px; width: self.preferred-width; visible: root.all || root.band == 0; text: root.labels[0]; font-size: 9px; color: Theme.text-faint; }
    b := Text { x: root.all ? root.bx0 : max(0px, min(root.width - self.width, root.bx0)); y: -3px; width: self.preferred-width; visible: root.all || root.band == 1; text: root.labels[1]; font-size: 9px; color: Theme.text-faint; }
    c := Text { x: root.all ? root.cx : max(0px, min(root.width - self.width, root.cx0)); y: -3px; width: self.preferred-width; visible: root.all || root.band == 2; text: root.labels[2]; font-size: 9px; color: Theme.text-faint; }
}

// One effect of the clip (spec §6.2, mockup A): a header — switch, name,
// ⋯ with Сбросить / Удалить / Выше / Ниже — and its 1–5 parameters.
export component FxBlock inherits VerticalLayout {
    in property <FxRow> fx;
    // The playhead is off the clip: animated numbers are locked (keyframes spec §6.1).
    in property <bool> outside;
    callback action(string /* effect id */, string /* toggle | reset | remove | up | down | choice:<key>:<i> | pick:<key> | moment:<key> */);
    callback live(string, float);
    callback commit(string, float);
    callback key-action(string, string);
    spacing: 2px;
    padding-top: 6px;
    menu := ContextMenuArea {
        Menu {
            MenuItem { title: Tr.t("fx.menu.reset"); enabled: root.fx.known && root.fx.resettable; activated => { root.action(root.fx.id, "reset"); } }
            MenuItem { title: Tr.t("fx.menu.remove"); activated => { root.action(root.fx.id, "remove"); } }
            MenuSeparator {}
            MenuItem { title: Tr.t("fx.menu.up"); enabled: !root.fx.first; activated => { root.action(root.fx.id, "up"); } }
            MenuItem { title: Tr.t("fx.menu.down"); enabled: !root.fx.last; activated => { root.action(root.fx.id, "down"); } }
        }
        VerticalLayout {
            // The header bar of the approved mockup.
            Rectangle {
                border-radius: Theme.radius;
                background: Theme.bg2;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 6px;
                    padding-right: 3px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        // Follows the project: the command, an undo, a refused edit.
                        BoundSwitch {
                            enabled: root.fx.known;
                            checked: root.fx.enabled;
                            toggled => { root.action(root.fx.id, "toggle"); }
                        }
                    }
                    Text { text: root.fx.name; font-size: Theme.font; font-weight: 600; color: root.fx.known && root.fx.enabled ? Theme.text : Theme.text-faint; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        more := IconButton {
                            icon: Icons.more;
                            filled: true;
                            size: 24px;
                            icon-size: 16px;
                            tooltip: Tr.t("fx.menu.tip");
                            tooltip-right: true;
                            clicked => { menu.show({ x: more.absolute-position.x - menu.absolute-position.x, y: more.absolute-position.y - menu.absolute-position.y + more.height }); }
                        }
                    }
                }
            }
        }
    }
    if !root.fx.known: Text { text: Tr.t("fx.unavailable"); font-size: Theme.font-xs; color: Theme.text-faint; wrap: word-wrap; }
    for p in root.fx.params: VerticalLayout {
        if p.kind == 0 && p.strength: AnimRow {
            prop: p.prop; k: p.k; outside: root.outside; label: p.label; value: p.value;
            minimum: p.minimum; maximum: p.maximum; default-value: p.default-value;
            display-scale: 100; decimals: 0; unit: "%";
            marks: [0.3, 0.6, 0.9]; snap: 0.025;
            live(a, v) => { root.live(a, v); }
            commit(a, v) => { root.commit(a, v); }
            key-action(a, b) => { root.key-action(a, b); }
        }
        if p.kind == 0 && p.strength: MarkCaptions { marks: [0.3, 0.6, 0.9]; value: p.value; labels: [Tr.t("fx.strength.soft"), Tr.t("fx.strength.normal"), Tr.t("fx.strength.strong")]; }
        if p.kind == 0 && !p.strength: AnimRow {
            prop: p.prop; k: p.k; outside: root.outside; label: p.label; value: p.value;
            minimum: p.minimum; maximum: p.maximum; default-value: p.default-value;
            live(a, v) => { root.live(a, v); }
            commit(a, v) => { root.commit(a, v); }
            key-action(a, b) => { root.key-action(a, b); }
        }
        if p.kind == 1: HorizontalLayout {
            height: 30px;
            spacing: 8px;
            Text { width: 84px; text: p.label; font-size: Theme.font-sm; color: Theme.text-dim; vertical-alignment: center; overflow: elide; }
            VerticalLayout { alignment: center; ChoiceSegments { options: p.options; tips: p.tips; current: p.current; selected(i) => { root.action(root.fx.id, "choice:" + p.key + ":" + i); } } }
            Rectangle { horizontal-stretch: 1; }
        }
        if p.kind == 2: HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Text { width: 84px; text: p.label; font-size: Theme.font-sm; color: Theme.text-dim; vertical-alignment: center; overflow: elide; }
            Text { text: p.text; font-size: Theme.font-sm; font-family: Theme.mono; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.crosshair; active: p.active; enabled: p.can-act || p.active; size: 24px; icon-size: 14px; tooltip: p.active ? Tr.t("fx.pick.cancel_tip") : Tr.t("fx.pick.tip"); tooltip-right: true; clicked => { root.action(root.fx.id, "pick:" + p.key); } }
            }
        }
        if p.kind == 3: HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Text { width: 84px; text: p.label; font-size: Theme.font-sm; color: Theme.text-dim; vertical-alignment: center; overflow: elide; }
            Text { text: p.text; font-size: Theme.font-sm; font-family: Theme.mono; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.to-playhead; enabled: p.can-act; size: 24px; icon-size: 14px; tooltip: Tr.t("fx.moment.to_playhead"); tooltip-right: true; clicked => { root.action(root.fx.id, "moment:" + p.key); } }
            }
        }
        // Under the row's control, not its label (as in the mockup).
        if p.hint != "": HorizontalLayout {
            padding-left: 92px;
            Text { text: p.hint; font-size: Theme.font-xs; color: Theme.text-faint; wrap: word-wrap; }
        }
    }
}
