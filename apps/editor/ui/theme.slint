// Kadr visual system: dark, low-noise, one accent. All colours and metrics
// live here so the whole app can be re-themed from one place.

export global Theme {
    // Surfaces (darkest → lightest)
    out property <color> bg0: #0e0f12;      // window / gutters
    out property <color> bg1: #15171b;      // panels
    out property <color> bg2: #1b1e23;      // headers, inputs, cards
    out property <color> bg3: #23272e;      // hover
    out property <color> bg4: #2c313a;      // pressed / active
    out property <color> border: #262a31;
    out property <color> border-strong: #353a44;

    // Text
    out property <color> text: #e7e9ec;
    out property <color> text-dim: #a3a9b4;
    out property <color> text-faint: #6c7380;
    out property <color> text-on-accent: #0e0f12;

    // Accents
    out property <color> accent: #7c8cff;           // selection / focus
    out property <color> accent-soft: #7c8cff26;
    out property <color> playhead: #ff5d52;
    out property <color> selection: #f5c451;        // selected clip outline
    out property <color> in-out: #7c8cff33;
    out property <color> snap: #f5c451;
    out property <color> marker: #e5a50a;
    out property <color> ai-a: #4fd1c5;
    out property <color> ai-b: #8b7cf6;
    out property <color> success: #3fb68b;
    out property <color> warning: #e5a50a;
    out property <color> danger: #ef5b5b;

    // Clips
    out property <color> clip-video: #34508f;
    out property <color> clip-video-top: #3f5fa6;
    out property <color> clip-audio: #2a6b55;
    out property <color> clip-audio-top: #318063;
    out property <color> clip-disabled: #3a3d44;
    out property <color> wave: #9fe3c7;

    // Metrics
    out property <length> radius: 6px;
    out property <length> radius-sm: 4px;
    out property <length> panel-header: 34px;
    out property <length> gap: 8px;
    out property <length> font-xs: 10px;
    out property <length> font-sm: 11px;
    out property <length> font: 12px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 20px;
    out property <string> mono: "Cascadia Mono";
}

